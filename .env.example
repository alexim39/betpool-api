# ------------------------------------------------------------------
# BetPool API environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# Server
PORT=8383
NODE_ENV=development
API_URL=https://api.betpool.tech
MONGODB_URI=mongodb://localhost:27017/betpool

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=7d
ADMIN_EMAILS=admin@betpool.tech

# Frontend
FRONTEND_URL=https://betpool.tech
CORS_ORIGIN=http://localhost:4200

# Email (digest + transactional)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=no-reply@betpool.tech
EMAIL_PASS=change-me
EMAIL_FROM=BetPool <no-reply@betpool.tech>

# SMS
BULKSMS_API_TOKEN=change-me
BULKSMS_SENDER_ID=BetPool

# Payments
PAYSTACK_SECRET_KEY=sk_test_change-me
PAYSTACK_PUBLIC_KEY=pk_test_change-me
PAYSTACK_WEBHOOK_SECRET=change-me
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-change-me
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-change-me
FLUTTERWAVE_WEBHOOK_HASH=change-me
BANK_TRANSFER_PROVIDER=paystack

# Sports data API
SPORTSAPI_PROVIDER=api-sports
SPORTSAPI_KEY=change-me
SPORTSAPI_BASE_URL=https://v3.football.api-sports.io
SPORTSAPI_LEAGUES=39,140,135,61,78
SPORTSAPI_SYNC_DAYS=3
SPORTSAPI_SEASON=2026

# Ora / DeepSeek (pod curation, pick reasons, personalization reasons)
DEEPSEEK_API_KEY=change-me
DEEPSEEK_MODEL=deepseek-chat
MARKETAI_MODEL=deepseek-chat
LLM_API_URL=https://api.deepseek.com/chat/completions

# Ora personalization
# Set to 1 to generate LLM pick-reason lines on personalized pods (slower, uses tokens)
PERSONALIZATION_LLM_REASONS=0

# Curation accuracy ledger: minimum settled-pick sample per league before
# league accuracy/win-rate signals influence ranking (float, default 5).
CURATION_ACCURACY_MIN_SAMPLE=5

# Ora automation
# Two-hour cycle: curation + publishing, Games Today, auto-settlement of
# concluded pods, bet-manager operations, profile warm-up.
ORA_AUTOMATION=enabled
# Cap on concurrently running pods created by the cycle (default 300).
MAX_ACTIVE_PODS=300

# Pod staking defaults
POD_DEFAULT_MIN_STAKE=100
POD_DEFAULT_MAX_STAKE=100000
POD_DEFAULT_EXPOSURE=500000

# Risk management
RISK_AUTO_CAP_THRESHOLD=15
RISK_CREATION_FREEZE_THRESHOLD=100
RISK_POD_SUSPEND_THRESHOLD=20
RISK_AUTO_ESCALATION=enabled

# Games Today live status watcher (every 3 minutes)
MATCH_STATUS_WATCHER=enabled

# Daily AI Briefing digest
DAILY_DIGEST=enabled
DAILY_DIGEST_HOUR=8
DIGEST_POOL_SIZE=10
DIGEST_PICK_COUNT=5
DIGEST_BATCH_SIZE=200
DIGEST_CONCURRENCY=5

# T4 financial advisory check (every 6 hours)
T4_ADVISORY=enabled

# Withdrawal reconciliation (every 5 minutes)
WITHDRAWAL_RECONCILIATION=enabled